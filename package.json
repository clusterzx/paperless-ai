{
  "name": "paperless-ai",
  "version": "4.0.0",
  "description": "AI-powered document classification, tagging and RAG chat for Paperless-ngx",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Clusterzx",
  "keywords": [
    "paperless-ngx",
    "ai",
    "rag",
    "ollama",
    "openai",
    "document-management"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "demo": "tsx e2e/demo-server.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.2.12",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "dompurify": "^3.4.16",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wouter": "^3.13.0"
  }
}
