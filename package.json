{
  "name": "paperless-ai",
  "version": "4.8.0",
  "description": "AI-powered document classification, tagging and RAG chat for Paperless-ngx",
  "type": "module",
  "bin": {
    "paperless-ai": "dist/server/cli.js"
  },
  "private": true,
  "license": "MIT",
  "author": "Clusterzx",
  "keywords": [
    "paperless-ngx",
    "ai",
    "rag",
    "ollama",
    "openai",
    "document-management"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json && node -e \"const fs=require('node:fs');fs.copyFileSync('src/server/mcp/bridge.mjs','dist/server/mcp/bridge.mjs');fs.copyFileSync('src/server/office/host.mjs','dist/server/office/host.mjs')\"",
    "build:web": "vite build",
    "fixture:archive": "tsx e2e/perf/fixture.ts",
    "perf": "tsx e2e/perf/run.ts",
    "start": "node dist/server/index.js",
    "cli": "node dist/server/cli.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm test",
    "demo": "tsx e2e/demo-server.ts",
    "test:e2e:builtin": "playwright test -c playwright.builtin.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.12",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.10.2",
    "jose": "^6.2.12",
    "mailparser": "^3.14.2",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.9",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "quickjs-emscripten-core": "^0.32.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@hyzyla/pdfium": "^3.0.0",
    "onnxruntime-node": "1.30.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "dompurify": "^3.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "lucide-react": "^1.49.0",
    "marked": "^18.0.14",
    "prettier": "^3.6.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.7",
    "vitest": "^5.0.3",
    "wouter": "^3.13.0"
  }
}
