# Paperless-AI is configured in the web interface (setup wizard / settings).
# Environment variables are optional and OVERRIDE the stored settings (shown as locked in the UI).
# All variables of Paperless-AI 3.x are still supported.

# PAPERLESS_AI_PORT=3000
# PAPERLESS_AI_DATA_DIR=./data

# --- Paperless-ngx (2.x or 3.x)
# PAPERLESS_API_URL=http://paperless:8000
# PAPERLESS_API_TOKEN=
# PAPERLESS_PUBLIC_URL=https://paperless.example.com

# --- AI provider: openai | anthropic | ollama | custom | azure
# AI_PROVIDER=ollama
# OLLAMA_API_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_NUM_CTX=16384        # fixed context size (0 = per document)
# OLLAMA_THINK=off            # auto | off | on | low | medium | high
# OLLAMA_UNLOAD_WHEN_IDLE=no
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5
# CUSTOM_BASE_URL=https://api.deepseek.com/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=deepseek-chat
# CUSTOM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
# AZURE_ENDPOINT=
# AZURE_API_KEY=
# AZURE_DEPLOYMENT_NAME=
# AZURE_API_VERSION=2024-10-21
# TOKEN_LIMIT=128000
# RESPONSE_TOKENS=1000

# --- Processing
# SCAN_INTERVAL=*/30 * * * *
# DISABLE_AUTOMATIC_PROCESSING=no
# PROCESS_PREDEFINED_DOCUMENTS=yes
# TAGS=pre-process
# REMOVE_TRIGGER_TAGS=no
# ADD_AI_PROCESSED_TAG=yes
# AI_PROCESSED_TAG_NAME=ai-processed
# OVERWRITE_CORRESPONDENT=no
# SHARE_CREATED_OBJECTS=yes

# --- Ask your archive (RAG): local | ollama | openai | custom | azure | none
# RAG_ENABLED=yes
# RAG_EMBEDDING_PROVIDER=local
# RAG_EMBEDDING_MODEL=
# RAG_QUERY_EXPANSION=yes

# --- Operations
# LOG_LEVEL=info
# LOG_FORMAT=json
# Certificates of your own CA (self-signed Paperless / AI server):
# NODE_EXTRA_CA_CERTS=/certs/my-ca.pem
